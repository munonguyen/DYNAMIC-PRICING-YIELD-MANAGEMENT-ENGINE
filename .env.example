# PostgreSQL
POSTGRES_PORT=5434
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/yield_engine
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis
REDIS_PORT=6380
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# Elasticsearch 8 (Fast Read & Real-Time Analytics CQRS)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URIS=http://localhost:9200

# Application
SERVER_PORT=8080
PRICING_TOKEN_SECRET=YieldEngineDeterministicSecretKeyHMACSHA256SecretValueMustBe256BitsMinimum!

# Gmail SMTP for QR E-Ticket Delivery (Use 16-char Google App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=munonguyen2005@gmail.com
MAIL_PASSWORD=

# MoMo PayGate v2 (configured sandbox or production merchant credentials)
